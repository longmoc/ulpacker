<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  UIBackgroundModes has to live in a real Info.plist: the
	  INFOPLIST_KEY_* build settings do not cover array-valued keys, so
	  declaring it there produced a build that looked correct and then
	  crashed on `allowsBackgroundLocationUpdates = true`.

	  Without this the app cannot record with the screen off, which is the
	  reason it is a native app at all.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
